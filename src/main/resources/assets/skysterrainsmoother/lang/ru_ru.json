  "config.skysterrainsmoother.enabled.tooltip": "\u0421\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u043d\u043e\u0432\u044b\u0435 \u0441\u0443\u0445\u0438\u0435 \u0441\u043a\u043b\u043e\u043d\u044b \u0438 \u043f\u043e\u043b\u044b \u043f\u0435\u0449\u0435\u0440 \u043e\u0431\u044b\u0447\u043d\u043e\u0433\u043e \u043c\u0438\u0440\u0430. \u0412\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0442\u0430\u043a\u0436\u0435 \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u0443\u044e \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044e Grass Slabs. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0447\u0430\u043d\u043a\u0438 \u043d\u0435 \u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f. \u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 Minecraft.",
  "config.skysterrainsmoother.smoothingLevel.tooltip": "1: \u043f\u043b\u0438\u0442\u044b. 2: \u043f\u043b\u0438\u0442\u044b \u0438 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438 \u0431\u043b\u043e\u043a\u0430. 3: \u0442\u0430\u043a\u0436\u0435 \u0432\u043e\u0441\u044c\u043c\u044b\u0435 \u0434\u043e\u043b\u0438 \u0431\u043b\u043e\u043a\u0430. \u041d\u0435\u0434\u043e\u0441\u0442\u0430\u044e\u0449\u0443\u044e \u0444\u043e\u0440\u043c\u0443 \u0437\u0430\u043c\u0435\u043d\u044f\u0435\u0442 \u043f\u043b\u0438\u0442\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0430\u043c, \u0433\u0434\u0435 \u043e\u043d\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e \u043f\u043e\u043c\u0435\u0449\u0430\u0435\u0442\u0441\u044f. \u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 Minecraft.",
  "config.skysterrainsmoother.enableMineralogy.tooltip": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0435 \u043f\u043b\u0438\u0442\u044b \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u044b\u0445 \u043f\u043e\u0440\u043e\u0434 Mineralogy, \u0435\u0441\u043b\u0438 \u043c\u043e\u0434 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d. \u041e\u0442\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u044b\u0435 \u0432\u0438\u0434\u044b \u043f\u043b\u0438\u0442 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u0441\u044f. \u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 Minecraft.",
