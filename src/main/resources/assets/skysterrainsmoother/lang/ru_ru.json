  "config.skysterrainsmoother.materials.soil": "\u0417\u0435\u043c\u043b\u044f \u0438 \u0434\u0451\u0440\u043d",
  "config.skysterrainsmoother.materials.soil.tooltip": "\u0421\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u0437\u0435\u043c\u043b\u044e \u0438 \u0434\u0451\u0440\u043d. \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0442\u0440\u0430\u0432\u044b Grass Slabs \u0442\u0430\u043a\u0436\u0435 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043a \u043d\u043e\u0432\u044b\u043c \u0441\u043a\u043b\u043e\u043d\u0430\u043c \u0438 \u043f\u043e\u043b\u0430\u043c \u043f\u0435\u0449\u0435\u0440. \u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 Minecraft.",
  "config.skysterrainsmoother.materials.sandAndGravel": "\u041f\u0435\u0441\u043e\u043a \u0438 \u0433\u0440\u0430\u0432\u0438\u0439",
  "config.skysterrainsmoother.materials.sandAndGravel.tooltip": "\u0421\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u043f\u0435\u0441\u043e\u043a, \u043a\u0440\u0430\u0441\u043d\u044b\u0439 \u043f\u0435\u0441\u043e\u043a \u0438 \u0433\u0440\u0430\u0432\u0438\u0439. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043a \u043d\u043e\u0432\u044b\u043c \u0441\u043a\u043b\u043e\u043d\u0430\u043c \u0438 \u043f\u043e\u043b\u0430\u043c \u043f\u0435\u0449\u0435\u0440. \u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 Minecraft.",
  "config.skysterrainsmoother.materials.stone": "\u041a\u0430\u043c\u0435\u043d\u044c \u0438 \u043f\u043e\u0440\u043e\u0434\u044b",
  "config.skysterrainsmoother.materials.stone.tooltip": "\u0421\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u043a\u0430\u043c\u0435\u043d\u044c, \u043f\u0435\u0441\u0447\u0430\u043d\u0438\u043a, \u0442\u0435\u0440\u0440\u0430\u043a\u043e\u0442\u0443 \u0438 \u043f\u043e\u0440\u043e\u0434\u044b \u0438\u0437 \u043c\u043e\u0434\u043e\u0432, \u0432\u043a\u043b\u044e\u0447\u0430\u044f Mineralogy \u0438 BOP. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043a \u043d\u043e\u0432\u044b\u043c \u0441\u043a\u043b\u043e\u043d\u0430\u043c \u0438 \u043f\u043e\u043b\u0430\u043c \u043f\u0435\u0449\u0435\u0440. \u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 Minecraft.",
  "config.skysterrainsmoother.materials.snow": "\u0421\u043d\u0435\u0433",
  "config.skysterrainsmoother.materials.snow.tooltip": "\u0421\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u0441\u043d\u0435\u0436\u043d\u044b\u0435 \u0431\u043b\u043e\u043a\u0438 \u0438 \u0440\u044b\u0445\u043b\u044b\u0439 \u0441\u043d\u0435\u0433. \u0417\u0430\u0441\u043d\u0435\u0436\u0435\u043d\u043d\u044b\u0439 \u0432\u0438\u0434 \u0434\u0451\u0440\u043d\u0430 \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043a \u043d\u043e\u0432\u044b\u043c \u0441\u043a\u043b\u043e\u043d\u0430\u043c \u0438 \u043f\u043e\u043b\u0430\u043c \u043f\u0435\u0449\u0435\u0440. \u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 Minecraft.",
  "config.skysterrainsmoother.materials.ice": "\u041b\u0451\u0434",
  "config.skysterrainsmoother.materials.ice.tooltip": "\u0421\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0435 \u0432\u0438\u0434\u044b \u043b\u044c\u0434\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u043b\u043e\u0442\u043d\u044b\u0439 \u043b\u0451\u0434. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043a \u043d\u043e\u0432\u044b\u043c \u0441\u043a\u043b\u043e\u043d\u0430\u043c \u0438 \u043f\u043e\u043b\u0430\u043c \u043f\u0435\u0449\u0435\u0440. \u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 Minecraft.",
  "config.skysterrainsmoother.materials.other": "\u0414\u0440\u0443\u0433\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f",
  "config.skysterrainsmoother.materials.other.tooltip": "\u0421\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0439, \u043d\u0435 \u043e\u0442\u043d\u0435\u0441\u0451\u043d\u043d\u044b\u0435 \u043a \u0434\u0440\u0443\u0433\u0438\u043c \u0433\u0440\u0443\u043f\u043f\u0430\u043c. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043a \u043d\u043e\u0432\u044b\u043c \u0441\u043a\u043b\u043e\u043d\u0430\u043c \u0438 \u043f\u043e\u043b\u0430\u043c \u043f\u0435\u0449\u0435\u0440. \u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 Minecraft."
